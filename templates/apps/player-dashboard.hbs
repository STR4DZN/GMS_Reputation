<section class="gms-player-dashboard gms-v2-tech-texture" data-gms-visual-generation="3" data-gms-build="59.10" data-player-matrix-surface data-profile-id="{{profileId}}" data-world-revision="{{worldRevision}}">
  {{> "modules/gms-reputation/templates/partials/background-art.hbs"}}
  <header class="gms-player-dashboard__header">
    <span class="gms-player-dashboard__vector-field" aria-hidden="true"></span>
    <span class="gms-player-dashboard__editorial-index" aria-hidden="true"><b>01</b><i>REL</i></span>
    <span class="gms-player-dashboard__header-notch" aria-hidden="true"></span>
    <span class="gms-player-dashboard__header-circuit" aria-hidden="true"></span>
    <div class="gms-player-dashboard__title" data-gms-v2-role="masthead">
      <small>GMS // MATRIZ DE REPUTAÇÃO</small>
      <strong>{{#if hasProfile}}{{profileName}}{{else}}SEM PERFIL DISPONÍVEL{{/if}}</strong>
    </div>
    <span class="gms-player-dashboard__live-update" data-player-live-update data-active="false" role="status" aria-live="polite"></span>
    {{#if canOpenMaster}}
      <button type="button" class="gms-player-dashboard__gm-btn" data-player-open-master title="Abrir Controle de Reputação (Modo Mestre)">
        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        <span>MODO MESTRE</span>
      </button>
    {{/if}}
  </header>

  {{#if hasProfile}}
    <div class="gms-player-dashboard__scroll" data-gms-v2-role="dossier-scroll">
      <div class="gms-player-dashboard__content" data-player-matrix-content>
      {{#if showProfileLibrary}}
        <details class="gms-profile-library" aria-label="Perfis de reputação organizados por grupo" data-player-profile-library>
          <summary class="gms-profile-library__trigger" aria-label="Abrir lista de perfis">
            <span class="gms-profile-library__current-thumb">{{#if currentProfile.image}}<img src="{{currentProfile.image}}" alt="">{{else}}<i class="fa-solid fa-user-astronaut" aria-hidden="true"></i>{{/if}}</span>
            <span class="gms-profile-library__current-copy"><small>PERFIL ATIVO // {{currentProfile.groupName}}</small><strong>{{currentProfile.focalName}}</strong><em>{{currentProfile.name}}</em></span>
            <span class="gms-profile-library__summary-meta"><small>{{profileGroups.length}} GRUPOS</small><strong>Trocar perfil</strong></span>
            <i class="fa-solid fa-chevron-down gms-profile-library__chevron" aria-hidden="true"></i>
          </summary>

          <div class="gms-profile-library__drawer">
            <header class="gms-profile-library__masthead">
              <div><small>DIRETÓRIO DE PERSPECTIVAS</small><strong>Perfis e grupos</strong><p>Abra um grupo e escolha a perspectiva desejada.</p></div>
              <span><i class="fa-solid fa-signal" aria-hidden="true"></i> SINCRONIZADO</span>
            </header>
            <div class="gms-profile-library__list" aria-label="Lista de grupos de perfis">
              {{#each profileGroups}}
                <details class="gms-profile-library__group" data-profile-group="{{id}}" data-active="{{active}}" {{#if active}}open{{/if}}>
                  <summary>
                    <span class="gms-profile-library__group-mark" aria-hidden="true"></span>
                    <span class="gms-profile-library__group-copy"><strong>{{name}}</strong></span>
                    <span class="gms-profile-library__group-count"><b>{{count}}</b><small>PERFIS</small></span>
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                  </summary>
                  <div class="gms-profile-library__profiles">
                    {{#each profiles}}
                      <button type="button" class="gms-profile-library__profile" data-player-profile-choice="{{id}}" data-selected="{{selected}}" aria-current="{{#if selected}}true{{else}}false{{/if}}">
                        <span class="gms-profile-library__thumb">{{#if image}}<img src="{{image}}" alt="" loading="lazy">{{else}}<i class="fa-solid fa-user-astronaut" aria-hidden="true"></i>{{/if}}</span>
                        <span class="gms-profile-library__identity"><strong>{{focalName}}</strong><small>{{name}}</small></span>
                        {{#if selected}}<span class="gms-profile-library__active">EM USO</span>{{else}}<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>{{/if}}
                      </button>
                    {{/each}}
                  </div>
                </details>
              {{/each}}
            </div>
          </div>
        </details>
      {{/if}}

      <section class="gms-player-dashboard__focal" aria-label="Perfil focal" data-gms-v2-role="focal-dossier">
        {{> "modules/gms-reputation/templates/partials/focal-profile.hbs" focal}}
      </section>

      <section class="gms-player-dashboard__records" aria-label="Relações do perfil" data-gms-v2-role="relationship-grid">
        {{#each cards}}
          {{> "modules/gms-reputation/templates/partials/player-card.hbs" this}}
        {{/each}}
      </section>
      </div>
    </div>
  {{else}}
    <div class="gms-player-dashboard__empty">
      <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
      <strong>Nenhum perfil social ativo.</strong>
      <p>O Mestre ainda não disponibilizou um perfil de reputação neste mundo.</p>
    </div>
  {{/if}}
</section>
