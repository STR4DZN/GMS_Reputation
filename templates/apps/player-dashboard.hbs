<section class="gms-player-dashboard gms-v2-tech-texture" data-gms-visual-generation="3" data-gms-build="59.10" data-player-matrix-surface data-profile-id="{{profileId}}" data-world-revision="{{worldRevision}}">
  {{> "modules/gms-reputation/templates/partials/background-art.hbs"}}
  <header class="gms-player-dashboard__header">
    <span class="gms-player-dashboard__vector-field" aria-hidden="true"></span>
    <span class="gms-player-dashboard__editorial-index" aria-hidden="true"><b>01</b><i>REL</i></span>
    <span class="gms-player-dashboard__header-notch" aria-hidden="true"></span>
    <span class="gms-player-dashboard__header-circuit" aria-hidden="true"></span>
    <div class="gms-player-dashboard__title" data-gms-v2-role="masthead">
      <small>GMS // MATRIZ DE REPUTAÇÃO</small>
      <strong>{{#if hasProfile}}{{profileName}}{{else}}SEM PERFIL DISPONÍVEL{{/if}}</strong>
    </div>
    <span class="gms-player-dashboard__live-update" data-player-live-update data-active="false" role="status" aria-live="polite"></span>
  </header>

  {{#if hasProfile}}
    <div class="gms-player-dashboard__scroll" data-gms-v2-role="dossier-scroll">
      <div class="gms-player-dashboard__content" data-player-matrix-content>
      <section class="gms-player-dashboard__focal" aria-label="Perfil focal" data-gms-v2-role="focal-dossier">
        {{> "modules/gms-reputation/templates/partials/focal-profile.hbs" focal}}
      </section>

      <section class="gms-player-dashboard__records" aria-label="Relações do perfil" data-gms-v2-role="relationship-grid">
        {{#each cards}}
          {{> "modules/gms-reputation/templates/partials/player-card.hbs" this}}
        {{/each}}
      </section>
      </div>
    </div>
    {{#if showProfileLibrary}}
      <div hidden data-player-navigation-mount>
        <details class="gms-npc-navigation" aria-label="Navegação de NPCs por grupo" data-player-profile-library {{#if profileLibraryOpen}}open{{/if}}>
          <summary class="gms-npc-navigation__toggle" data-player-navigation-toggle aria-label="Abrir ou recolher navegação de NPCs" title="Navegação de NPCs">
            <i class="fa-solid fa-users" aria-hidden="true"></i>
            <span>NPCs</span>
            <i class="fa-solid fa-chevron-left gms-npc-navigation__arrow" aria-hidden="true"></i>
          </summary>
          <div class="gms-npc-navigation__drawer">
            <header class="gms-npc-navigation__current">
              <span class="gms-npc-navigation__portrait">{{#if currentProfile.image}}<img src="{{currentProfile.image}}" alt="">{{else}}<i class="fa-solid fa-user" aria-hidden="true"></i>{{/if}}</span>
              <div><span class="gms-npc-navigation__label">Perfil atual</span><strong>{{currentProfile.focalName}}</strong></div>
            </header>
            <div class="gms-npc-navigation__list" data-player-navigation-list aria-label="Grupos e NPCs">
              {{#each profileGroups}}
                <details class="gms-npc-navigation__group" data-profile-group="{{id}}" data-active="{{active}}" {{#if active}}open{{/if}}>
                  <summary title="{{name}}">
                    <span class="gms-npc-navigation__group-name">{{name}}</span>
                    <span class="gms-npc-navigation__count" aria-label="{{count}} perfis">{{count}}</span>
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                  </summary>
                  <div class="gms-npc-navigation__profiles">
                    {{#each profiles}}
                      <button type="button" class="gms-npc-navigation__profile" data-player-profile-choice="{{id}}" data-selected="{{selected}}" aria-current="{{#if selected}}true{{else}}false{{/if}}" title="{{name}}">
                        <span class="gms-npc-navigation__portrait">{{#if image}}<img src="{{image}}" alt="" loading="lazy">{{else}}<i class="fa-solid fa-user" aria-hidden="true"></i>{{/if}}</span>
                        <span class="gms-npc-navigation__name">{{focalName}}</span>
                        {{#if selected}}<i class="fa-solid fa-check gms-npc-navigation__selected" aria-hidden="true"></i>{{/if}}
                      </button>
                    {{/each}}
                  </div>
                </details>
              {{/each}}
            </div>
          </div>
        </details>
      </div>
    {{/if}}
  {{else}}
    <div class="gms-player-dashboard__empty">
      <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
      <strong>Nenhum perfil social ativo.</strong>
      <p>O Mestre ainda não disponibilizou um perfil de reputação neste mundo.</p>
    </div>
  {{/if}}
</section>
