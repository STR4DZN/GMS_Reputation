<section class="gms-master-panel gms-v2-tech-texture" data-master-panel-root data-master-context-profile="{{profileId}}" data-master-context-subject="{{subjectId}}" data-master-context-group="{{profileEditor.groupId}}" data-gms-visual-generation="3" data-gms-build="59.10" data-gms-navigation="enhanced" data-gms-v2-surface="command-deck" data-master-active-section="{{activeSection}}">
  {{> "modules/gms-reputation/templates/partials/background-art.hbs"}}
  {{#if authorized}}
{{> "modules/gms-reputation/templates/partials/master-header.hbs"}}
{{> "modules/gms-reputation/templates/partials/master-savebar.hbs"}}
    <div class="gms-master-panel__layout">
{{> "modules/gms-reputation/templates/partials/master-navigation.hbs"}}
      <main class="gms-master-panel__content" data-gms-v2-role="command-workspace">
{{> "modules/gms-reputation/templates/partials/master-subjects.hbs"}}
{{> "modules/gms-reputation/templates/partials/master-profile.hbs"}}
{{> "modules/gms-reputation/templates/partials/master-characters.hbs"}}
{{> "modules/gms-reputation/templates/partials/master-relationship.hbs"}}
{{> "modules/gms-reputation/templates/partials/master-portrait.hbs"}}
{{> "modules/gms-reputation/templates/partials/master-focal.hbs"}}
{{> "modules/gms-reputation/templates/partials/master-history.hbs"}}
{{> "modules/gms-reputation/templates/partials/master-cleanup.hbs"}}
{{> "modules/gms-reputation/templates/partials/master-settings.hbs"}}
      </main>
    </div>
  {{else}}
    <div class="gms-master-panel__denied"><i class="fa-solid fa-lock" aria-hidden="true"></i><strong>Acesso não autorizado para esta função.</strong></div>
  {{/if}}
  {{> "modules/gms-reputation/templates/partials/navigation-palette.hbs"}}
</section>
