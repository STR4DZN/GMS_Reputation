<div class="gms-workbench" data-reputation-workbench data-view="{{workbench.matrix}}">
  <aside class="gms-workbench-npcs" aria-label="NPCs e perspectivas">
    <header><strong>Perspectivas</strong><small>Quem está avaliando</small></header>
    <label class="gms-workbench-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-grid-npc-search value="{{workbench.npcSearch}}" placeholder="Buscar NPC…" aria-label="Buscar NPC"></label>
    <select data-grid-group aria-label="Grupo de NPCs"><option value="">Todos os grupos</option>{{#each workbench.groups}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}<option value="__ungrouped__" {{#if workbench.ungrouped}}selected{{/if}}>Sem grupo</option></select>
    <div class="gms-workbench-npc-list">{{#each workbench.choices}}<button type="button" data-grid-npc="{{id}}" aria-pressed="{{selected}}"><span class="gms-workbench-npc-glyph" aria-hidden="true">{{> "modules/gms-reputation/templates/partials/portrait-frame.hbs" portrait}}</span><span><strong>{{name}}</strong><small>{{group}}</small></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>{{else}}<p class="gms-workbench-empty">Nenhum NPC nesta busca.</p>{{/each}}</div>
    <button type="button" class="gms-workbench-manage" data-grid-manage="profiles"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Organizar NPCs e perfis</button>
  </aside>
  <div class="gms-workbench-main">
    <header class="gms-workbench-heading">{{#unless workbench.matrix}}<div class="gms-workbench-focal">{{> "modules/gms-reputation/templates/partials/portrait-frame.hbs" workbench.portrait}}</div>{{/unless}}<div class="gms-workbench-heading-copy"><small>{{#if workbench.matrix}}Reputação{{else}}Perfil focal{{/if}}</small><h2>{{#if workbench.matrix}}Matriz de relações{{else}}{{workbench.profileName}}{{/if}}</h2><p>{{#if workbench.matrix}}Personagens nas linhas. NPCs nas colunas. Edite sem sair da tabela.{{else}}{{#if workbench.description}}{{workbench.description}}{{else}}Relações deste NPC com o elenco.{{/if}}{{/if}}</p></div></header>
    <div class="gms-workbench-toolbar"><div class="gms-workbench-views" role="group" aria-label="Visualização da reputação"><button type="button" data-grid-view="roster" aria-pressed="{{workbench.roster}}"><i class="fa-solid fa-list" aria-hidden="true"></i> Elenco do NPC</button><button type="button" data-grid-view="matrix" aria-pressed="{{workbench.matrix}}"><i class="fa-solid fa-table-cells" aria-hidden="true"></i> Matriz completa</button></div><label class="gms-workbench-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-grid-search value="{{workbench.search}}" placeholder="Filtrar personagens…" aria-label="Filtrar personagens"></label></div>
    <div class="gms-workbench-batch" data-grid-batch hidden>
      <div class="gms-workbench-batch-heading"><strong data-grid-selection-label></strong><button type="button" data-grid-clear-selection>Cancelar seleção</button></div>
      <div class="gms-workbench-batch-actions"><span>Ajustar corações</span><button type="button" data-grid-batch-delta="-1">−1</button><button type="button" data-grid-batch-delta="-0.5">−0,5</button><button type="button" data-grid-batch-delta="0.5">+0,5</button><button type="button" data-grid-batch-delta="1">+1</button><select data-grid-batch-mode aria-label="Tipo de ajuste em lote"><option value="set">Definir valor</option><option value="delta">Somar valor</option></select><input type="number" data-grid-batch-value step="0.5" min="-12" max="12" value="0" aria-label="Valor em lote"><button type="button" data-grid-batch-apply>Aplicar ao rascunho</button></div>
      <small>Os valores aparecem na tabela antes de salvar. {{#if workbench.matrix}}Marque as colunas dos NPCs que devem receber o ajuste.{{/if}}</small>
    </div>
    {{#if workbench.roster}}
    <div class="gms-workbench-roster" data-grid-scroll tabindex="0" aria-label="Dossiês de reputação">
      <label class="gms-roster-select-all">{{#if workbench.canBulk}}<input type="checkbox" data-grid-select-page aria-label="Selecionar personagens desta página">Selecionar página para ajustar em lote{{/if}}<span>{{workbench.rangeText}}</span></label>
      {{#each workbench.rows}}
      <article class="gms-master-dossier" data-grid-row="{{id}}" data-selected="{{selected}}" style="--gms-row-accent:{{accent}}">
        <span class="gms-master-dossier__frame" aria-hidden="true"></span>
        <div class="gms-master-dossier__select">{{#if ../workbench.canBulk}}<input type="checkbox" data-grid-select-subject="{{id}}" {{#if selected}}checked{{/if}} aria-label="Selecionar {{name}} para lote">{{/if}}</div>
        <button type="button" class="gms-master-dossier__portrait" data-grid-character="{{id}}" title="Editar imagem e cadastro de {{name}}"><span class="gms-workbench-avatar">{{> "modules/gms-reputation/templates/partials/portrait-frame.hbs" portrait}}</span><span class="gms-sr-only">Editar imagem de {{name}}</span></button>
        <div class="gms-master-dossier__identity"><strong>{{name}}</strong><span>{{realName}}</span></div>
        {{#each cells}}
        <div class="gms-grid-cell gms-master-dossier__relation" data-grid-cell data-grid-profile="{{profileId}}" data-grid-subject="{{subjectId}}" data-grid-member="{{member}}" data-dirty="{{dirty}}" style="--gms-grid-accent:{{accent}}">
          <span class="gms-master-dossier__band" data-grid-relation-label>{{label}}</span>
          <div class="gms-workbench-hearts gms-reputation-heart-track" data-grid-hearts role="group" aria-label="Definir corações de {{../name}}" data-special-state="{{specialState}}">
          {{#each hearts}}<button type="button" class="gms-reputation-heart" data-grid-heart="{{value}}" data-heart-state="{{state}}" data-heart-ordinal="{{ordinal}}" data-special-slot="{{specialSlot}}" data-special-kind="{{specialKind}}" tabindex="{{#if @first}}0{{else}}-1{{/if}}" aria-label="Definir {{value}} corações" title="{{value}} corações; metade esquerda ou Shift para meio coração" {{#if ../../../workbench.canEdit}}{{else}}disabled{{/if}}><i aria-hidden="true"></i></button>{{/each}}
          </div>
          <small class="gms-workbench-dirty-label" data-grid-pending {{#unless dirty}}hidden{{/unless}}>{{changeText}}</small>
          <div class="gms-master-dossier__controls">
            <div class="gms-workbench-stepper"><button type="button" data-grid-delta="-0.5" aria-label="Retirar meio coração de {{../name}}" {{#unless ../../workbench.canEdit}}disabled{{/unless}}>−</button><input type="number" data-grid-score step="0.5" min="-10" max="{{limit}}" value="{{score}}" aria-label="Corações de {{../name}}" {{#unless ../../workbench.canEdit}}disabled{{/unless}}><button type="button" data-grid-delta="0.5" aria-label="Adicionar meio coração a {{../name}}" {{#unless ../../workbench.canEdit}}disabled{{/unless}}>+</button></div>
            <div class="gms-master-dossier__polarity" role="group" aria-label="Polaridade da relação"><button type="button" data-grid-polarity="positive" aria-pressed="{{#if negative}}false{{else}}true{{/if}}" {{#unless ../../workbench.canEdit}}disabled{{/unless}}>Positiva</button><button type="button" data-grid-polarity="negative" aria-pressed="{{negative}}" {{#unless ../../workbench.canEdit}}disabled{{/unless}}>Negativa</button><button type="button" data-grid-zero {{#unless ../../workbench.canEdit}}disabled{{/unless}} title="Zerar corações sem remover protocolos">Zerar</button></div>
          </div>
          <div class="gms-workbench-protocols" role="group" aria-label="Protocolos de {{../name}}"><button type="button" data-grid-protocol="bond" aria-pressed="{{bond}}" {{#unless ../../workbench.canEdit}}disabled{{/unless}}><img src="modules/gms-reputation/assets/icons/bond-sigil.svg" alt="">Vínculo</button><button type="button" data-grid-protocol="communion" aria-pressed="{{communion}}" {{#unless ../../workbench.canEdit}}disabled{{/unless}}><img src="modules/gms-reputation/assets/icons/communion-sigil.svg" alt="">Comunhão</button><small data-grid-special>{{special}}</small></div>
        </div>
        {{/each}}
      </article>
      {{else}}<div class="gms-workbench-empty"><strong>Nenhum personagem nesta seleção.</strong><p>Refine a busca ou inclua personagens no elenco do NPC.</p><button type="button" data-grid-manage="characters">Organizar elenco</button></div>{{/each}}
    </div>
    {{else}}
    <div class="gms-workbench-table-scroll" data-grid-scroll tabindex="0" aria-label="Tabela de reputação com rolagem">
      <table class="gms-workbench-table {{#if workbench.matrix}}is-matrix{{else}}is-roster{{/if}}">
        <caption class="gms-sr-only">{{#if workbench.matrix}}Matriz de corações entre personagens e NPCs{{else}}Reputação do elenco com {{workbench.profileName}}{{/if}}</caption>
        <thead><tr><th scope="col" class="gms-workbench-selection">{{#if workbench.canBulk}}<input type="checkbox" data-grid-select-page aria-label="Selecionar personagens desta página">{{/if}}</th><th scope="col" class="gms-workbench-subject">Personagem</th>{{#if workbench.matrix}}{{#each workbench.profiles}}<th scope="col">{{#if ../workbench.canBulk}}<input type="checkbox" data-grid-select-profile="{{id}}" {{#if selected}}checked{{/if}} aria-label="Incluir {{name}} no ajuste em lote">{{/if}}<button type="button" data-grid-npc="{{id}}" title="Abrir elenco de {{name}}">{{name}}</button></th>{{/each}}{{else}}<th scope="col">Corações <span class="gms-workbench-column-note">clique para definir</span></th><th scope="col">Score</th><th scope="col">Protocolos</th>{{/if}}</tr></thead>
        <tbody>{{#each workbench.rows}}<tr data-grid-row="{{id}}" data-selected="{{selected}}" style="--gms-row-accent:{{accent}}"><td class="gms-workbench-selection">{{#if ../workbench.canBulk}}<input type="checkbox" data-grid-select-subject="{{id}}" {{#if selected}}checked{{/if}} aria-label="Selecionar {{name}}">{{/if}}</td><th scope="row" class="gms-workbench-subject"><button type="button" data-grid-character="{{id}}" title="Editar cadastro e imagem de {{name}}"><span class="gms-workbench-avatar">{{> "modules/gms-reputation/templates/partials/portrait-frame.hbs" portrait}}</span><span><strong>{{name}}</strong><small>{{realName}}</small></span></button></th>
          {{#each cells}}{{#if ../../workbench.matrix}}<td><div class="gms-grid-cell" data-grid-cell data-grid-profile="{{profileId}}" data-grid-subject="{{subjectId}}" data-grid-member="{{member}}" data-dirty="{{dirty}}" style="--gms-grid-accent:{{accent}}">{{#if member}}<div class="gms-workbench-stepper"><button type="button" data-grid-delta="-0.5" aria-label="Retirar meio coração" {{#if ../../workbench.canEdit}}{{else}}disabled{{/if}}>−</button><input type="number" data-grid-score step="0.5" min="-10" max="{{limit}}" value="{{score}}" aria-label="Corações de {{../name}} com este NPC" {{#if ../../workbench.canEdit}}{{else}}disabled{{/if}}><button type="button" data-grid-delta="0.5" aria-label="Adicionar meio coração" {{#if ../../workbench.canEdit}}{{else}}disabled{{/if}}>+</button></div><span data-grid-relation-label>{{label}}</span><small data-grid-special>{{special}}</small>{{else}}<span class="gms-workbench-no-member" title="Este personagem não está no elenco deste NPC">Fora do elenco</span>{{/if}}</div></td>{{/if}}{{/each}}
        </tr>{{else}}<tr><td colspan="9"><div class="gms-workbench-empty"><strong>Nenhum personagem nesta seleção.</strong><p>Refine a busca ou inclua os personagens no elenco do NPC.</p><button type="button" data-grid-manage="characters">Organizar elenco</button></div></td></tr>{{/each}}</tbody>
      </table>
    </div>
    {{/if}}
    <footer class="gms-workbench-footer"><div><strong data-grid-status role="status" aria-live="polite">{{#if workbench.dirty}}{{workbench.dirty}} relações editadas{{else}}Sem alterações pendentes{{/if}}</strong><span>{{workbench.total}} personagens · passos de 0,5 · limites −10 / +10 ou +12</span></div><div class="gms-workbench-pages">{{#if workbench.paginated}}<span>Personagens</span><button type="button" data-grid-page="-1" aria-label="Página anterior de personagens" {{#if workbench.prev}}{{else}}disabled{{/if}}>‹</button><span>{{workbench.pageText}}</span><button type="button" data-grid-page="1" aria-label="Próxima página de personagens" {{#if workbench.next}}{{else}}disabled{{/if}}>›</button>{{/if}}{{#if workbench.matrix}}<span>NPCs</span><button type="button" data-grid-columns="-1" aria-label="Página anterior de NPCs" {{#if workbench.prevColumns}}{{else}}disabled{{/if}}>‹</button><span>{{workbench.columnText}}</span><button type="button" data-grid-columns="1" aria-label="Próxima página de NPCs" {{#if workbench.nextColumns}}{{else}}disabled{{/if}}>›</button>{{/if}}</div></footer>
    <label class="gms-workbench-reason"><span>Motivo para o histórico <small>opcional</small></span><input type="text" data-grid-reason value="{{workbench.reason}}" maxlength="2000" placeholder="Ex.: consequências da missão"></label>
  </div>
</div>
