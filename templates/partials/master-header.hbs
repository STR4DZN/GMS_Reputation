    <header class="gms-master-panel__header" data-gms-v2-role="command-masthead">
      <span class="gms-master-panel__header-mark" aria-hidden="true"></span>
      <div><small>GMS // CONTROLE DE REPUTAÇÃO</small><strong>MATRIZ SOCIAL</strong><span>Perfis, personagens e relações em um fluxo único de comando.</span></div>
    </header>

    <div class="gms-navigation-bar" aria-label="Navegação do painel">
      <div class="gms-navigation-bar__history"><button type="button" data-navigation-back aria-label="Voltar ao contexto anterior" title="Voltar · Alt + ←" disabled>←</button><button type="button" data-navigation-forward aria-label="Avançar contexto" title="Avançar · Alt + →" disabled>→</button></div>
      <div class="gms-navigation-bar__breadcrumb"><small>{{profileName}}</small><strong data-navigation-location>{{activeSectionLabel}}</strong></div>
      <button type="button" class="gms-navigation-bar__command" data-navigation-open><span aria-hidden="true">⌕</span><span>Ir para…</span><kbd>Ctrl K</kbd></button>
      {{#if personalReputation.linked}}<button type="button" class="gms-navigation-bar__command" data-personal-reputation-open>Meu resumo</button>{{/if}}
      <button type="button" class="gms-navigation-bar__player" data-master-open-player title="Abrir este perfil na Matriz do Player"><span aria-hidden="true">↗</span><span>Visão Player</span></button>
    </div>

    <section class="gms-master-panel__selection-bus" aria-label="Seleção ativa">
      <div class="gms-master-panel__selection-copy">
        <small>VOCÊ ESTÁ EDITANDO</small>
        <strong>{{#if subjectEditor}}{{subjectEditor.alias}}{{else}}Escolha um personagem{{/if}}</strong>
      </div>
      <div class="gms-master-panel__selectors">
        {{> "modules/gms-reputation/templates/partials/smart-selector.hbs" profileSelector}}
        {{> "modules/gms-reputation/templates/partials/smart-selector.hbs" subjectSelector}}
        <div class="gms-navigation-context-step"><button type="button" data-navigation-subject-step="-1" aria-label="Personagem anterior" title="Personagem anterior" {{#if hasPreviousSubject}}{{else}}disabled{{/if}}>‹</button><span>{{subjectPosition}} / {{subjects.length}}</span><button type="button" data-navigation-subject-step="1" aria-label="Próximo personagem" title="Próximo personagem" {{#if hasNextSubject}}{{else}}disabled{{/if}}>›</button></div>
      </div>
    </section>

