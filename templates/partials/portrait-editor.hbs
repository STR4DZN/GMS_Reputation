<section class="gms-reputation-portrait-editor" data-portrait-editor data-portrait-kind="{{kind}}">
  <div class="gms-reputation-portrait-editor__preview" data-portrait-preview tabindex="0" aria-label="Pré-visualização e posicionamento do retrato">
    {{> "modules/gms-reputation/templates/partials/portrait-frame.hbs"}}
  </div>

  <p class="gms-portrait-source-label" data-portrait-source-label>{{sourceName}}</p>
  <p data-portrait-status role="status" aria-live="polite">{{#if hasImage}}Ajuste o enquadramento e salve.{{else}}Escolha uma imagem no Foundry ou use um link direto.{{/if}}</p>
  <div class="gms-portrait-feedback-actions"><button type="button" data-action="retryPortrait" hidden>Tentar carregar novamente</button></div>
  <div class="gms-reputation-portrait-editor__source">
    <input type="hidden" name="portraitSrc" value="{{portrait.src}}">
    <label>
      <span>Link direto de imagem ou GIF</span>
      <input type="url" name="portraitUrl" value="{{remoteUrl}}" placeholder="https://site.com/imagem.gif" autocomplete="off" spellcheck="false">
    </label>
    <button type="button" data-action="usePortraitUrl">Usar link</button>
    <button type="button" data-action="pickPortrait">Escolher no Foundry</button>
    <button type="button" data-action="removePortrait">Remover imagem</button>
  </div>

  <label class="gms-reputation-portrait-editor__fit">
    <span>Enquadramento</span>
    <select name="portraitFit" aria-label="Enquadramento da imagem">
      {{#each fitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
    <small>Imagem inteira preserva a proporção e pode deixar margens. Preencher ocupa o quadro com recorte, sem deformar.</small>
  </label>

  <div class="gms-reputation-portrait-editor__calibration">
    <label><span>Zoom</span><span class="gms-portrait-numeric"><input type="number" data-portrait-number="zoom" min="50" max="300" step="1" value="{{portrait.zoom}}" aria-label="Zoom em porcentagem">%</span><input type="range" name="portraitZoom" min="50" max="300" step="1" value="{{portrait.zoom}}"></label>
    <label><span>Horizontal</span><span class="gms-portrait-numeric"><input type="number" data-portrait-number="x" min="0" max="100" step="1" value="{{portrait.x}}" aria-label="Posição horizontal em porcentagem">%</span><input type="range" name="portraitX" min="0" max="100" step="1" value="{{portrait.x}}"></label>
    <label><span>Vertical</span><span class="gms-portrait-numeric"><input type="number" data-portrait-number="y" min="0" max="100" step="1" value="{{portrait.y}}" aria-label="Posição vertical em porcentagem">%</span><input type="range" name="portraitY" min="0" max="100" step="1" value="{{portrait.y}}"></label>
    <div class="gms-portrait-frame-actions"><button type="button" data-action="centerPortrait">Centralizar</button><button type="button" data-action="resetPortraitFrame">Restaurar enquadramento</button></div>
  </div>

  <p class="gms-reputation-portrait-editor__hint">Zoom amplia sem distorcer. Acima de 100%, partes da imagem podem sair do quadro. Arraste a prévia para reposicionar; setas movem 1%, Shift + seta move 5%. Resetar volta à imagem inteira, centralizada em 100%.</p>
</section>
